# Copy this file to `.env` so `docker compose up` auto-loads it.
#
# Required.
# DB_PASSWORD must be URL-safe (it is embedded in DATABASE_URL), so generate it
# with hex: `openssl rand -hex 32`. AUTH_SECRET is not used in a URL, so either
# `openssl rand -hex 32` or `openssl rand -base64 32` is fine.
DB_PASSWORD=changeme
AUTH_SECRET=changeme

# Optional overrides
# DB_NAME=arbor
# DB_USER=postgres
# DB_PORT=5432
# API_PORT=4000
# APP_PORT=3000
# GIT_GRPC_PORT=50051
# GIT_HTTP_PORT=8080
